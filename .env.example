# انسخ هذا الملف إلى .env وعدل القيم
DATABASE_URL=postgresql://suqai:suqai_secure_password@localhost:5432/suqai?schema=public
NEXTAUTH_SECRET=your-secret-key-change-in-production
SESSION_SECRET=another-secret-key-change-in-production
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
SEED_PASSWORD=

# Docker Compose
DB_USER=suqai
DB_PASSWORD=suqai_secure_password
DB_NAME=suqai
DOMAIN=localhost
SSL_EMAIL=
REDIS_URL=

# Backup
BACKUP_RETENTION_DAYS=7

# External Monitoring (Healthchecks.io)
HEALTHCHECKS_URL=
HEALTHCHECKS_INTERVAL=300

# Sentry (optional)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
